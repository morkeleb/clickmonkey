{
  "name": "clickmonkey",
  "version": "2.0.0-alpha.0",
  "description": "QA agent that maps a site and drives it through a line DSL",
  "type": "module",
  "main": "dist/index.js",
  "repository": "github:morkeleb/clickmonkey",
  "license": "MIT",
  "author": "Morten Nielsen",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "clickmonkey": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/cli-usage.test.ts tests/schema.test.ts tests/merge.unit.test.ts",
    "test:unit": "node --import tsx --test tests/cli-usage.test.ts tests/schema.test.ts tests/merge.unit.test.ts",
    "clickmonkey": "node --import tsx src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
