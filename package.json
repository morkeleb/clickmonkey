{
  "name": "clickmonkey",
  "version": "2.0.0-alpha.0",
  "description": "QA agent that maps a site and drives it through a line DSL",
  "type": "module",
  "main": "dist/index.js",
  "repository": "github:morkeleb/clickmonkey",
  "license": "MIT",
  "author": "Morten Nielsen",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "bin": {
    "clickmonkey": "bin/clickmonkey.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm install --prefix web --no-fund && npm run build --prefix web",
    "dev:ui": "npm run dev --prefix web",
    "link": "npm link && node scripts/install-completions.mjs",
    "test": "node scripts/run-tests.mjs unit",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:live": "node scripts/run-tests.mjs live",
    "clickmonkey": "node --import tsx src/cli/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inquirer/prompts": "^8.5.2",
    "html-validate": "^11.8.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  }
}
